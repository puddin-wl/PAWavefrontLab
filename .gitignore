# Generated datasets and reconstruction outputs
/data/
/outputs/
/vis/
/neuws_hy/data/

# Raw acquisition files, archives, and large generated arrays
*.bin
*.mat
*.tif
*.tiff
*.zip
*.7z
*.npy
*.npz

# Reproducible denoising outputs and local result archives
/denoising/motor_crosstalk/runs/
/denoising/motor_crosstalk/results_archive/*
!/denoising/motor_crosstalk/results_archive/README.md
/denoising/noise_review/aline_analysis/*.png
/denoising/noise_review/pd_comparison/
/denoising/noise_review/time_gate_test/
/denoising/noise_review/results/*
!/denoising/noise_review/results/.gitkeep

# Existing tracked PPT figures are the reviewed canonical set. New generated
# figures stay local unless explicitly reviewed and force-added.
/denoising/motor_crosstalk/ppt_assets/*
!/denoising/motor_crosstalk/ppt_assets/README.md

# Machine-local real-experiment configuration
/configs/real_experiment.json

# Local run logs and temporary review patches (formal log/*.md notes stay tracked)
/log/*.log
/*.patch
/archives/patches/*.patch

# Local CUDA profiler outputs
*.nsys-rep
*.sqlite
reference_guided_600.log

# Python caches and environments
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/

# IDE and OS metadata
.vscode/
.idea/
.DS_Store
Thumbs.db
*:Zone.Identifier
