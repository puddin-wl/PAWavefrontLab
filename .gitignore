# Generated datasets and reconstruction outputs
/data/
/outputs/
/vis/

# Raw acquisition files, archives, and large generated arrays
*.bin
*.mat
*.tif
*.tiff
*.zip
*.7z
*.npy
*.npz

# Reproducible denoising outputs and local result archives
/motor_crosstalk_denoise/runs/
/motor_crosstalk_denoise/results_archive/*
!/motor_crosstalk_denoise/results_archive/README.md
/noise_cause_review/aline_analysis/*.png
/noise_cause_review/pd_comparison/
/noise_cause_review/time_gate_test/
/noise_cause_review/results/*
!/noise_cause_review/results/.gitkeep

# Existing tracked PPT figures are the reviewed canonical set. New generated
# figures stay local unless explicitly reviewed and force-added.
/motor_crosstalk_denoise/ppt_assets/*
!/motor_crosstalk_denoise/ppt_assets/README.md

# Machine-local real-experiment configuration
/configs/real_experiment.json

# Local run logs and temporary review patches (formal log/*.md notes stay tracked)
/log/*.log
/*.patch

# Local CUDA profiler outputs
*.nsys-rep
*.sqlite
reference_guided_600.log

# Python caches and environments
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/

# IDE and OS metadata
.vscode/
.idea/
.DS_Store
Thumbs.db
*:Zone.Identifier
